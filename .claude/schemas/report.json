{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SynthesisReport",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "summary": {
      "type": "string"
    },
    "sections": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "category_name": {
            "type": "string"
          },
          "findings": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "claim": {
                  "type": "string"
                },
                "agreement_type": {
                  "type": "string",
                  "enum": ["well-established", "contested", "single-source"]
                },
                "provenance": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "source_url": {
                        "type": "string"
                      },
                      "excerpt": {
                        "type": "string"
                      },
                      "confidence": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1
                      },
                      "timestamp": {
                        "type": "string"
                      },
                      "agent_id": {
                        "type": "string"
                      }
                    },
                    "required": ["source_url", "excerpt", "confidence", "timestamp", "agent_id"]
                  }
                }
              },
              "required": ["claim", "agreement_type", "provenance"]
            }
          }
        },
        "required": ["category_name", "findings"]
      }
    },
    "agent_id": {
      "type": "string"
    }
  },
  "required": ["title", "summary", "sections", "agent_id"]
}
