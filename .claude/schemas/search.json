{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SearchFindings",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "claim": {
        "type": "string"
      },
      "source_url": {
        "type": "string"
      },
      "excerpt": {
        "type": "string"
      },
      "confidence": {
        "type": "number",
        "minimum": 0,
        "maximum": 1
      },
      "timestamp": {
        "type": "string"
      },
      "agent_id": {
        "type": "string"
      }
    },
    "required": ["claim", "source_url", "excerpt", "confidence", "timestamp", "agent_id"]
  }
}
